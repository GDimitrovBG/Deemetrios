# <<< END GENERATED

# --- Old WP product slugs → canonical ref URL ---
# e.g. /product/mermaid-wedding-dress-style-1537/ → /product/1537
#
# NOTE: this rule alone is only safe for NUMERIC refs. For lettered refs it
# emits a lower-cased target (/product/dr436), which has no prerendered
# directory — the SPA fallback then served the HOME page's HTML and canonical
# under a product URL, and only client-side JS corrected it. That is why the
# GENERATED case block above must come first: it 301s straight to the
# exact-case URL in one hop. Do not reorder them.
@wp_product path_regexp wpprod ^/product/.+-style-([A-Za-z0-9]+)/?$
redir @wp_product /product/{re.wpprod.1} 301

# --- Discontinued products → collection (301, one hop) ---
# Some old WP product URLs point at refs no longer in the catalogue (AM*,
# T238SK30 …). Their prerendered directory does not exist, so without this they
# fell through to the SPA fallback. Anything under /product/ with no prerendered
# index.html is, by definition, not a current product. This MUST come after the
# case-canonicalisation block above, or valid lower-cased refs would land here
# instead of on their exact-case page.
#
# ⚠ VERIFY THIS ONE AFTER RELOAD. The `file` matcher resolves against the
#   active `root`; inside a `route` block that root may differ from what you
#   expect, and if the lookup fails the matcher inverts to "matches everything"
#   — sending EVERY /product/* URL to /collection. Check immediately:
#       curl -I https://demetriosbride-bg.com/product/1500   → must be 200
#   If it 301s, drop this block. It is an optimisation, not a requirement: the
#   /404.html fallback already answers discontinued products with a noindex
#   404; this rule only upgrades that to a 301 that passes link equity.
@prod_gone {
	path_regexp ^/product/.+
	not file {path}/index.html
}
redir @prod_gone /collection 301

# --- Old WP content archives with no SPA equivalent → nearest page (301) ---
# Author/tag/date archives from the old WordPress site. Redirecting (not 410)
# preserves any residual link equity and gives the user a useful landing page.
@wp_author path_regexp ^/author/.*$
redir @wp_author / 301
@wp_tag    path_regexp ^/tag/.*$
redir @wp_tag    /collection 301
@wp_date   path_regexp ^/20\d\d(/\d{2})?/?$
redir @wp_date   /blog 301

# --- Dead WP technical URLs → 410 Gone ---
# Feeds, wp-json, xmlrpc, comment feeds etc. must never be indexed. Returning
# 410 (Gone) tells Google they are permanently removed, so they drop out of the
# index quickly instead of lingering as soft-404 (noindex) entries in Coverage.
@wp_dead     path_regexp ^/(wp-json|xmlrpc\.php|wp-login\.php|wp-content/.*\.php|comments/feed|feed)(/.*)?$
respond @wp_dead 410
@wp_feed_any path_regexp ^/.+/feed/?$
respond @wp_feed_any 410
